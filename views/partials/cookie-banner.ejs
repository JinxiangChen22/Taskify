<div
  id="taskify-cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-labelledby="taskify-cookie-banner-title"
  aria-describedby="taskify-cookie-banner-desc"
  style="display: none;"
>
  <div class="cookie-banner-content">
    <div class="cookie-banner-text">
      <h2 id="taskify-cookie-banner-title" class="cookie-banner-title">Cookies</h2>
      <p id="taskify-cookie-banner-desc" class="cookie-banner-desc">
        We use essential cookies to support login sessions and remember your cookie preference.
        You can read more in our <a href="/privacy">Privacy Policy</a>.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button id="taskify-cookie-banner-accept" class="cookie-banner-btn" type="button">
        Accept
      </button>
      <button id="taskify-cookie-banner-decline" class="cookie-banner-btn cookie-banner-btn-secondary" type="button">
        Decline
      </button>
    </div>
  </div>
</div>

